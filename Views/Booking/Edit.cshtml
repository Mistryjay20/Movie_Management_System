@model Movie_Management_System.Models.Booking

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Booking</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- BOOKING ID -->
        <div class="form-group">
            <div class="col-md-10">

                <input type="hidden"
                       id="booking_id"
                       name="Booking_id"
                       value="@Model.Booking_id" />

                @Html.ValidationMessageFor(
                    model => model.Booking_id,
                    "",
                    new { @class = "text-danger" })

            </div>
        </div>


        <!-- CATEGORY -->
        <div class="form-group">

            @Html.LabelFor(
                model => model.Cat_id,
                "Category",
                htmlAttributes: new
                {
                    @class = "control-label col-md-2"
                })

            <div class="col-md-10">

                <select id="cat_id"
                        name="Cat_id"
                        class="form-control"
                        onchange="changeCategory(this.value);">

                    @if (ViewBag.CategoryList != null)
                    {
                        <option value="">--Select Category--</option>

                        foreach (var item in ViewBag.CategoryList)
                        {
                            <option value="@item.Value"
                                    @(item.Value == Model.Cat_id.ToString() ? "selected" : "")>

                                @item.Text

                            </option>
                        }
                    }

                </select>

                @Html.ValidationMessageFor(
                    model => model.Cat_id,
                    "",
                    new { @class = "text-danger" })

            </div>
        </div>


        <!-- MOVIE -->
        <div class="form-group">

            @Html.LabelFor(
                model => model.Movie_id,
                "Movie Name",
                htmlAttributes: new
                {
                    @class = "control-label col-md-2"
                })

            <div class="col-md-10">

                <select id="movie_id"
                        name="Movie_id"
                        class="form-control"
                        onchange="changeMovie(this.value);">

                    @if (ViewBag.MovieList != null)
                    {
                        <option value="">--Select Movie--</option>

                        foreach (var item in ViewBag.MovieList)
                        {
                            <option value="@item.Value"
                                    @(item.Value == Model.Movie_id.ToString() ? "selected" : "")>

                                @item.Text

                            </option>
                        }
                    }

                </select>

                @Html.ValidationMessageFor(
                    model => model.Movie_id,
                    "",
                    new { @class = "text-danger" })

            </div>
        </div>


        <!-- NUMBER OF TICKETS -->
        <div class="form-group">

            @Html.LabelFor(
                model => model.No_of_Tickets,
                "No of Tickets",
                htmlAttributes: new
                {
                    @class = "control-label col-md-2"
                })

            <div class="col-md-10">

                <input type="number"
                       id="no_of_ticket"
                       name="No_of_Tickets"
                       class="form-control"
                       value="@Model.No_of_Tickets"
                       min="1"
                       onchange="changeTickets(this.value);" />

                @Html.ValidationMessageFor(
                    model => model.No_of_Tickets,
                    "",
                    new { @class = "text-danger" })

            </div>
        </div>


        <!-- AMOUNT -->
        <div class="form-group">

            @Html.LabelFor(
                model => model.amount,
                "Amount",
                htmlAttributes: new
                {
                    @class = "control-label col-md-2"
                })

            <div class="col-md-10">

                <!-- Display calculated amount -->
                <input type="text"
                       class="form-control"
                       value="@ViewBag.TotalPrice"
                       readonly />

                <!-- Amount sent to POST -->
                <input type="hidden"
                       name="amount"
                       value="@Model.amount" />

            </div>
        </div>


        <!-- SAVE -->
        <div class="form-group">

            <div class="col-md-offset-2 col-md-10">

                <input type="submit"
                       value="Save"
                       class="btn btn-default" />

            </div>

        </div>

    </div>
}

<div>
    @Html.ActionLink("Back to List", "Details")
</div>


<script>

    function changeCategory(categoryId)
    {
        var bookingId =
            document.getElementById("booking_id").value;

        window.location.href =
            '@Url.Action("Edit", "Booking")'
            + '?id=' + bookingId
            + '&cat_id=' + categoryId;
    }


    function changeMovie(movieId)
    {
        var bookingId =
            document.getElementById("booking_id").value;

        var categoryId =
            document.getElementById("cat_id").value;

        window.location.href =
            '@Url.Action("Edit", "Booking")'
            + '?id=' + bookingId
            + '&cat_id=' + categoryId
            + '&movie_id=' + movieId;
    }


    function changeTickets(ticketCount)
    {
        var bookingId =
            document.getElementById("booking_id").value;

        var categoryId =
            document.getElementById("cat_id").value;

        var movieId =
            document.getElementById("movie_id").value;

        window.location.href =
            '@Url.Action("Edit", "Booking")'
            + '?id=' + bookingId
            + '&cat_id=' + categoryId
            + '&movie_id=' + movieId
            + '&no_of_ticket=' + ticketCount;
    }

</script>